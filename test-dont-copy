local function updateViewportScaling()
    local camera = workspace.CurrentCamera
    if not camera then return end
    local vp = camera.ViewportSize
    if vp.Y <= 0 then return end
    local screenRatio = vp.X / vp.Y
    local dominant = (screenRatio >= 1.7927) and Enum.DominantAxis.Height or Enum.DominantAxis.Width
    G2L["b"].DominantAxis = dominant
    G2L["55"].DominantAxis = dominant
    G2L["7f"].DominantAxis = dominant
    G2L["e4"].DominantAxis = dominant
    G2L["10d"].DominantAxis = dominant
end
workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateViewportScaling)
task.spawn(updateViewportScaling)

