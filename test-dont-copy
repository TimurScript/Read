        local icon = Instance.new("ImageLabel", card)
        icon.BorderSizePixel = 0
        icon.ScaleType = Enum.ScaleType.Fit
        icon.BackgroundColor3 = Color3.fromRGB(255,255,255)
        icon.Image = "rbxthumb://type=AvatarHeadShot&id="..player.UserId.."&w=48&h=48"
        icon.Size = UDim2.new(0.08931, 0, 0.63918, 0)
        icon.BackgroundTransparency = 0.96
        icon.Name = "Icon"
        icon.Position = UDim2.new(0.03248, 0, 0.20652, 0)

        local uiCornerIcon = Instance.new("UICorner", icon)
        uiCornerIcon.CornerRadius = UDim.new(1, 0)

        local username = Instance.new("TextLabel", icon)
        username.BorderSizePixel = 0
        username.TextSize = 23
        username.TextScaled = true
        username.TextXAlignment = Enum.TextXAlignment.Left
        username.BackgroundColor3 = Color3.fromRGB(255,255,255)
        username.FontFace = Font.new([[rbxassetid://11702779517]], Enum.FontWeight.SemiBold, Enum.FontStyle.Normal)
        username.TextColor3 = Color3.fromRGB(150, 150, 150)
        username.BackgroundTransparency = 1
        username.Size = UDim2.new(3.0303, 0, 0.59677, 0)
        username.Text = "@"..player.Name
        username.Name = "Username"
        username.Position = UDim2.new(1.28788, 0, 0.1939, 0)
        local uConst = Instance.new("UITextSizeConstraint", username)
        uConst.MaxTextSize = 23

        -- Goto button
        local gotoBtn = Instance.new("ImageButton", card)
        gotoBtn.BorderSizePixel = 0
        gotoBtn.AutoButtonColor = false
        gotoBtn.BackgroundTransparency = 0.8
        gotoBtn.BackgroundColor3 = Color3.fromRGB(255,255,255)
        gotoBtn.Size = UDim2.new(0.08796, 0, 0.62887, 0)
        gotoBtn.Name = "Goto"
        gotoBtn.Position = UDim2.new(0.88039, 0, 0.15497, 0)
        Instance.new("UICorner", gotoBtn).CornerRadius = UDim.new(0, 10)

        local tpLabel = Instance.new("TextLabel", gotoBtn)
        tpLabel.BorderSizePixel = 0
        tpLabel.BackgroundTransparency = 1
        tpLabel.Size = UDim2.new(1, 0, 1, 0)
        tpLabel.TextSize = 18
        tpLabel.TextScaled = true
        tpLabel.FontFace = Font.new([[rbxassetid://11702779517]], Enum.FontWeight.Bold, Enum.FontStyle.Normal)
        tpLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
        tpLabel.Text = "TP"
        tpLabel.Name = "Label"
        local tpConst = Instance.new("UITextSizeConstraint", tpLabel)
        tpConst.MaxTextSize = 18

        gotoBtn.MouseEnter:Connect(function()
            tween:Create(gotoBtn, TweenInfo.new(0.2), {BackgroundTransparency = 0.6}):Play()
        end)
        gotoBtn.MouseLeave:Connect(function()
            tween:Create(gotoBtn, TweenInfo.new(0.2), {BackgroundTransparency = 0.8}):Play()
        end)

        gotoBtn.MouseButton1Click:Connect(function()
            local char = player.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                local me = game.Players.LocalPlayer.Character
                if me and me:FindFirstChild("HumanoidRootPart") then
                    me.HumanoidRootPart.CFrame = char.HumanoidRootPart.CFrame + Vector3.new(3,0,0)
                end
            end
        end)

        return card
    end

    local function updateList()
        for _, child in list:GetChildren() do
            if child:IsA("CanvasGroup") then child:Destroy() end
        end
        for _, player in Players:GetPlayers() do
            makeCard(player)
        end
    end

    Players.PlayerAdded:Connect(function() task.wait() updateList() end)
    Players.PlayerRemoving:Connect(function() task.wait() updateList() end)
    updateList()
end;
