local function runLibScript(entry, statusLabel)
    task.spawn(function()
        statusLabel.Text = "Loading..."
        local fetched, source = pcall(function()
            return game:HttpGet(entry.url)
        end)
        if not fetched or type(source) ~= "string" or source == "" then
            statusLabel.Text = "Fetch Failed"
            warn("[ScriptLib] Failed to fetch " .. entry.name .. ": " .. tostring(source))
            task.wait(2)
            statusLabel.Text = entry.tag
            return
        end

        if type(loadstring) ~= "function" then
            statusLabel.Text = "Executor Required"
            warn("[ScriptLib] loadstring is unavailable in this environment.")
            task.wait(2)
            statusLabel.Text = entry.tag
            return
        end

        local chunk, compileErr = loadstring(source)
        if not chunk then
            statusLabel.Text = "Compile Error"
            warn("[ScriptLib] Compile error in " .. entry.name .. ": " .. tostring(compileErr))
            task.wait(2)
            statusLabel.Text = entry.tag
            return
        end

        local ok, runErr = pcall(chunk)
        if ok then
            statusLabel.Text = "Executed"
        else
            statusLabel.Text = "Runtime Error"
            warn("[ScriptLib] Runtime error in " .. entry.name .. ": " .. tostring(runErr))
        end
        task.wait(2)
        statusLabel.Text = entry.tag
    end)
end

